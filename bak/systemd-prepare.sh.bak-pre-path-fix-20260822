#!/bin/bash
# clean isolt — generator wrapperów (user service, graphical-session-pre, oneshot)
#
# Co robi:
#   Czyści wrappers/ i generuje świeże wrappery dla aplikacji (taskset + nice).
#   Wrappery są wywoływane przez .desktop files i autostart entries.
#
# Wywoływany przez: ~/.config/systemd/user/systemd-prepare.service

set -e

ROOT="/home/grruwi/Dokumenty/skrypcipki/clean isolt/wrappers"

# 1. Tabula rasa wrapperów (każdy run = czysty stan)
rm -f "$ROOT"/*-tune

# 2. Generator (standardowy)
#    prlimit --nice=20: RLIMIT_NICE ceiling = 0 → Electron próbujący setpriority(-8) dostaje EPERM
#    (Electron sam by sobie wrzucił nice -8 i konkurował z kwin/audio — to blokuje)
gen() {
    local name="$1" affinity="$2" binary="$3" envs="$4"
    cat > "$ROOT/${name}-tune" <<EOF
#!/bin/bash
# Auto-generated by systemd-prepare.sh — nie edytuj ręcznie
exec env $envs prlimit --nice=20 taskset -c $affinity $binary "\$@"
EOF
    chmod +x "$ROOT/${name}-tune"
}

# 2b. Generator BEZ prlimit — sama maska CPU.
#     Dla aplikacji, które nie próbują sobie podnosić nice (nie-Electron), więc
#     RLIMIT_NICE ceiling nie ma czego blokować i tylko zaciemniałby wrapper.
gen_mask() {
    local name="$1" affinity="$2" binary="$3" envs="$4"
    cat > "$ROOT/${name}-tune" <<EOF
#!/bin/bash
# Auto-generated by systemd-prepare.sh — nie edytuj ręcznie
exec env $envs taskset -c $affinity $binary "\$@"
EOF
    chmod +x "$ROOT/${name}-tune"
}

# 3. Generator pod sudo (dla narzędzi wymagających roota, np. scxtop dla BPF)
#    NOPASSWD jest w /etc/sudoers.d/claude-access — sudo nie pyta hasła.
#    EUID-aware: jeśli już jesteśmy rootem (np. wywołanie przez `sudo scxtop`
#    z secure_path, znajdującym wrapper w /usr/local/bin), pomijamy ponowny sudo.
#    Brak prlimit bo sudo nie potrzebuje tego ceila.
gen_sudo() {
    local name="$1" affinity="$2" binary="$3"
    cat > "$ROOT/${name}-tune" <<EOF
#!/bin/bash
# Auto-generated by systemd-prepare.sh — nie edytuj ręcznie
if [ "\$EUID" -eq 0 ]; then
    exec taskset -c $affinity $binary "\$@"
else
    exec sudo taskset -c $affinity $binary "\$@"
fi
EOF
    chmod +x "$ROOT/${name}-tune"
}

# 2026-05-26: REWERS — kwin/plasma/audio na 0,8, electrony+claude+klodzio na 7,15.
# 2026-05-30: po diagnozie 1960→269 mig/s na 0,8, zwężamy heavy emiterów do 7,15
#             (firefox/chatterino/steam-client/dolphin/kate). Discord mało migruje
#             (5/s) — zostaje szeroko. Spotify zostaje szeroko z PIPEWIRE_LATENCY
#             bo zwężenie powodowało cache miss spike przy maximize (komentarz 04:11).
#             scxtop przeniesiony tu z ~/.local/bin (single source of truth).

# Heavy emitery — zwężone do P7 (śmietnik):
gen firefox    1-7,9-15      /usr/bin/firefox
gen chatterino 1-7,9-15      /usr/bin/chatterino
gen steam      1-7,9-15      /usr/bin/steam
gen konsole    1-7,9-15      /usr/bin/konsole
gen dolphin    1-7,9-15      /usr/bin/dolphin
gen kate       1-7,9-15      /usr/bin/kate

# Background bez patologii — zostawiamy szeroko (mało migrują):
gen discord    1-7,9-15  /usr/bin/discord   "ELECTRON_OZONE_PLATFORM_HINT=auto"
# 2026-06-13: 2048→8192 (~170ms) — spoti dusił sam siebie (burst GUI głodził wątek
# audio w klatce 6,7,14,15 → underrun, licznik ERR w pw-top). Lag suwaka głośności
# in-app = rozmiar bufora, świadomie zaakceptowany (poziomy i tak w OBS/systemie).
gen spotify    1-7,9-15  /usr/bin/spotify   "PIPEWIRE_LATENCY=8192/48000"

# Claude CLI — śmietnik 1-7,9-15 (z klodzio razem, z dala od kwin+audio).
# Od 2026-06-01: instalka żyje w ~/.claude/local/ (XDG redirect: ~/.local/share/claude
# → ~/.claude/local/share/claude). Wrapper celuje w ~/.claude/local/claude (symlink
# → versions/X.Y.Z, raw binary). Legacy ~/.local/bin/claude.original.symlink (2.1.150)
# zachowany jako backup, ale nie używany przez wrappery.
# 2026-06-13: zwężony do samego 7,15 — wcześniejsze 0,7,8,15 dawało startup burst
# (JIT po updacie CLI, 12 wątków) na CPU 0 = SMT sibling rdzenia audio (CPU 8).
gen claude     1-7,9-15          /home/grruwi/.claude/local/claude

# Voicebox NATYWNY (GUI Tauri) — maska jak systemd.cpu_affinity w cmdline.
# ⚠️ Dotyczy TYLKO natywki. Kontener voicebox-slim ma swoje `cpuset` w compose —
# Docker i tak kasuje odziedziczona maske wlasnym cgroupem.
# Wrapper celuje w binarke GUI; backend `voicebox-server-rocm` startuje jako jej
# dziecko i maske dziedziczy. Bez prlimit — Voicebox nie podnosi sobie nice.
# ⚠️ Sama maska NIE zamyka tematu: watki HSA/ROCm wolaja sched_setaffinity same
# i wychodza na 0-15 mimo maski rodzica (zmierzone 2026-08-11: 2 z 75 watkow).
# Twarde zamkniecie wymagaloby cgroup cpuset, nie tasksetu.
gen_mask voicebox 1-7,9-15 /home/grruwi/Dokumenty/voicebox-native/tauri/src-tauri/target/release/voicebox

# scxtop — BPF monitoring, wymaga roota. Wcześniej zżerał 50% migracji na 0,8
# (Rust + tokio runtime). Sudo via NOPASSWD w /etc/sudoers.d/.
gen_sudo scxtop 1-7,9-15     /usr/bin/scxtop

echo "[systemd-prepare] wrappery wygenerowane w $ROOT"
ls -1 "$ROOT"
