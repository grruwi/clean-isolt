[Unit]
Description=NIC low-latency tuning (Intel I226-V / eno1)
After=network.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c '  ethtool -C eno1 rx-usecs 0;   ethtool -K eno1 gro off gso off tso off;   echo 1000 > /proc/irq/100/smp_affinity;   echo 2000 > /proc/irq/101/smp_affinity'

[Install]
WantedBy=multi-user.target
